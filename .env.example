# Local-only server. Set a different PORT if needed.
PORT=5173
# Generate your own long password before enabling /yonetim.
ADMIN_PASSWORD=
# No bank is connected. No card data or payment is accepted.
PAYMENT_PROVIDER=disabled
# Google: choose 'business' for all reviews or 'places' for Google's selected reviews.
GOOGLE_REVIEWS_PROVIDER=business
GOOGLE_MAPS_URL=https://www.google.com/maps?cid=1539703208462618989
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=
# Alternative Places API (New): up to five reviews, not the complete history.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Smart chat assistant. Empty key = built-in rule-based answers + WhatsApp handoff.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
# Public site address used for canonical links, Open Graph, robots.txt and sitemap.xml.
SITE_URL=https://rotakarsturizm.com
# Social sign-in; separate OAuth clients from Google Business Profile credentials.
# Exact site origin. For Apple this must be a verified HTTPS domain, not localhost.
PUBLIC_BASE_URL=http://127.0.0.1:5174
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM private key with literal \n separators, kept only on the server.
APPLE_PRIVATE_KEY=
# Behind a trusted single reverse proxy only:
TRUST_PROXY=0

# MongoDB (replica set required for transactions).
# Local: `docker compose up -d mongo`, then use the line below.
# Railway: reference the Mongo service variable, e.g. MONGODB_URI="${{MongoDB.MONGO_URL}}"
# (the URL must include replicaSet=rs0; see docs/RAILWAY-AND-OPERATIONS.md).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=rota-kars
# E-mail: all three SMTP_HOST, MAIL_FROM and PUBLIC_BASE_URL are required.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
REMINDER_HOURS=24
# Agency staff inboxes (comma separated) for new bookings, cancellation and lead alerts.
AGENCY_EMAIL=
# Abuse limits for seat holds and pre-reservations.
SALES_CUTOFF_MINUTES=60
GUEST_MAX_SEATS=10
IP_MAX_HELD_SEATS=20
HOLD_LIMIT_PER_15MIN=20
BOOKING_LIMIT_PER_15MIN=6
GOOGLE_REVIEW_URL=
# Production does not insert sample departures. Explicitly enable only for demos.
SEED_DEMO=0
# Instagram API (Instagram ile giriş): hesabın Reels videoları kartta üzerine gelince oynar.
# Meta for Developers → uygulama → Instagram → API setup with Instagram login → Generate token.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_MAX_VIDEOS=8
INSTAGRAM_CACHE_MINUTES=30
# File storage (Railway Storage Bucket, S3-compatible) for admin image/video uploads.
# On Railway reference the bucket service variables, e.g. ENDPOINT="${{bucket.ENDPOINT}}".
ENDPOINT=
REGION=auto
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
BUCKET=
# Only for buckets created before Railway switched to virtual-hosted URLs:
S3_FORCE_PATH_STYLE=false
