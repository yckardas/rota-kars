{
  "name": "rota-kars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "google:connect": "node scripts/google-connect.mjs",
    "typecheck": "tsc -b",
    "format": "prettier --write src server tests vite.config.ts tsconfig.json package.json README.md docs",
    "format:check": "prettier --check src server tests vite.config.ts tsconfig.json package.json README.md docs",
    "demo": "node scripts/demo-server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fontsource/marcellus": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.1.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10"
  }
}
