# Local-only server. Set a different PORT if needed.
PORT=5173
# Shared password used ONLY to create the first owner account at /yonetim.
# After the first named admin account exists, this password no longer signs in.
ADMIN_PASSWORD=
# No bank is connected. No card data or payment is accepted.
PAYMENT_PROVIDER=disabled
# Google: choose 'business' for all reviews or 'places' for Google's selected reviews.
GOOGLE_REVIEWS_PROVIDER=business
GOOGLE_MAPS_URL=https://www.google.com/maps?cid=1539703208462618989
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=
# Alternative Places API (New): up to five reviews, not the complete history.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Smart chat assistant. Empty key = built-in rule-based answers + WhatsApp handoff.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
# Public site address used for canonical links, Open Graph, robots.txt and sitemap.xml.
SITE_URL=https://rotakarsturizm.com
# Social sign-in; separate OAuth clients from Google Business Profile credentials.
# Exact site origin. For Apple this must be a verified HTTPS domain, not localhost.
PUBLIC_BASE_URL=http://127.0.0.1:5174
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM private key with literal \n separators, kept only on the server.
APPLE_PRIVATE_KEY=
# Optional: signs the short-lived OAuth state cookie. Derived from the provider secrets when empty.
OAUTH_STATE_SECRET=
# Cloudflare Turnstile (bot protection on booking, sign-up and request forms).
# Both empty = disabled. Create a widget at dash.cloudflare.com → Turnstile, add your domain.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Behind a trusted single reverse proxy only:
TRUST_PROXY=0

# MongoDB. A single node (Railway default) works; a replica set is used automatically if present.
# Local: `docker compose up -d mongo`, then use the line below.
# Railway: reference the Mongo service variable, e.g. MONGO_URL="${{MongoDB.MONGO_URL}}"
MONGODB_URI=mongodb://127.0.0.1:27017/
MONGODB_DB=rota-kars
# E-mail: all three SMTP_HOST, MAIL_FROM and PUBLIC_BASE_URL are required.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
REMINDER_HOURS=24
# Agency staff inboxes (comma separated) for new bookings, cancellation and lead alerts.
AGENCY_EMAIL=
# Abuse limits for seat holds and pre-reservations.
SALES_CUTOFF_MINUTES=60
GUEST_MAX_SEATS=10
IP_MAX_HELD_SEATS=20
HOLD_LIMIT_PER_15MIN=20
BOOKING_LIMIT_PER_15MIN=6
# Unconfirmed pre-reservations keep seats this long; one email can hold at most N pending seats.
PENDING_HOLD_HOURS=24
PENDING_SEATS_PER_EMAIL=12
# Failed logins allowed across all IPs per 15 min before login is paused.
LOGIN_GLOBAL_LIMIT=200
GOOGLE_REVIEW_URL=
# Production does not insert sample departures. Explicitly enable only for demos.
SEED_DEMO=0
# Instagram API (Instagram ile giriş): hesabın Reels videoları kartta üzerine gelince oynar.
# Meta for Developers → uygulama → Instagram → API setup with Instagram login → Generate token.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_MAX_VIDEOS=8
INSTAGRAM_CACHE_MINUTES=30
# File storage (Railway Storage Bucket, S3-compatible) for admin image/video uploads.
# On Railway reference the bucket service variables, e.g. ENDPOINT="${{bucket.ENDPOINT}}".
ENDPOINT=
REGION=auto
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
BUCKET=
# Only for buckets created before Railway switched to virtual-hosted URLs:
S3_FORCE_PATH_STYLE=false
# Admin accounts: two-factor authentication is required in production by default.
# Set ADMIN_REQUIRE_2FA=0 to make it optional (not recommended).
ADMIN_REQUIRE_2FA=
# KVKK retention (days). Paid bookings are kept 10 years (VUK/TTK), then anonymized.
RETENTION_UNPAID_DAYS=365
RETENTION_PAID_DAYS=3653
RETENTION_REQUEST_DAYS=730
RETENTION_NOTIFICATION_DAYS=90
RETENTION_AUDIT_DAYS=730

# Android yönetici uygulaması (docs/ANDROID-YONETIM-UYGULAMASI.md)
# Firebase hizmet hesabı JSON'u (tek satır veya base64). Boşsa telefon bildirimi gönderilmez.
FIREBASE_SERVICE_ACCOUNT=
# Uygulama güncelleme uyarısı: en yeni sürüm, imzalı APK'nın HTTPS adresi, isteğe bağlı not ve zorunlu en düşük sürüm.
ANDROID_APP_VERSION=
ANDROID_APK_URL=
ANDROID_APP_NOTES=
ANDROID_APP_MIN_VERSION=
# Yeni Google yorumu bildirimi: yukarıdaki GOOGLE_PLACES_API_KEY + GOOGLE_PLACE_ID ile çalışır.
# Kontrol aralığı dakika (varsayılan 60, en az 15).
GOOGLE_REVIEW_POLL_MINUTES=60
# Yönetici "bu cihazı hatırla" süresi (gün, en fazla 30). Yalnız 2FA açık hesaplarda geçerli.
ADMIN_REMEMBER_DAYS=14
